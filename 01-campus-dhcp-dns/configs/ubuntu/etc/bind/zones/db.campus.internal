; =============================================================================
; Zone campus.internal (forward)
; =============================================================================
$TTL 3600
@               IN  SOA   ns1.campus.internal. hostmaster.campus.internal. (
                          2026111401 ; serial (YYYYMMDDnn)
                          3600       ; refresh
                          900        ; retry
                          1209600    ; expire
                          300 )      ; negative-cache TTL
                IN  NS    ns1.campus.internal.

; --- DNS/DHCP server ----------------------------------------------------------
ns1             IN  A     192.168.100.10
srv-dns01       IN  A     192.168.100.10
dns             IN  CNAME srv-dns01
dhcp            IN  CNAME srv-dns01

; --- core / default gateways (SVIs) -------------------------------------------
core-main       IN  A     192.168.100.1
vlan10-gw       IN  A     192.168.10.1
vlan20-gw       IN  A     192.168.20.1
vlan30-gw       IN  A     192.168.30.1
vlan40-gw       IN  A     192.168.40.1
vlan50-gw       IN  A     192.168.50.1
vlan60-gw       IN  A     192.168.60.1
core-1          IN  CNAME vlan10-gw
core-2          IN  CNAME vlan30-gw
core-3          IN  CNAME vlan50-gw
