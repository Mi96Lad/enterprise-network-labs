# VPCS startup command per endpoint: ip <address> <gateway> <prefix length>
PC-1     ip 172.16.10.10 172.16.10.1 24
PC-2     ip 172.16.20.20 172.16.20.1 24
PC-3     ip 172.16.30.30 172.16.30.1 24
SRV-1    ip 10.20.30.9 10.20.30.1 24
SRV-2    ip 10.20.30.7 10.20.30.1 24
SRV-3    ip 10.20.30.5 10.20.30.1 24
i-SRV1   ip 170.3.3.3 170.3.1.1 16
i-SRV2   ip 170.5.5.5 170.5.1.1 16
i-SRV3   ip 170.7.7.7 170.7.1.1 16
i-SRV4   ip 180.3.3.3 180.3.1.1 16
i-SRV5   ip 180.5.5.5 180.5.1.1 16
i-SRV6   ip 180.7.7.7 180.7.1.1 16
